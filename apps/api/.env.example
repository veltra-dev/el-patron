# Copie para apps/api/.env e preencha.

PORT=3000
# URL pública da API (no Render: https://elpatron-api.onrender.com).
# Em dev, use um túnel (ngrok/cloudflared) ou http://host.docker.internal:3000 com a Evolution local.
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
DEFAULT_TIMEZONE=America/Sao_Paulo

# Claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (low = respostas mais rápidas e baratas)
AI_EFFORT=low
AI_HISTORY_MESSAGES=20

# OpenAI (só para transcrever áudio)
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Supabase (Project Settings > API). Use a service_role key: ela fica só no servidor.
SUPABASE_URL=https://xxxx.supabase.co
# Só para `pnpm db:migrate`: Supabase > Connect > Session pooler
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=troque-esta-chave
EVOLUTION_INSTANCE=elpatron
# openssl rand -hex 24
WEBHOOK_SECRET=

# Contato do suporte mostrado a quem não é cliente (opcional) e intervalo entre avisos
SUPPORT_CONTACT=
UNKNOWN_REPLY_COOLDOWN_DAYS=7

# Google Calendar (opcional). Redirect URI autorizada: {PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Segredo compartilhado com o painel web (mesmo valor no Vercel). openssl rand -hex 32
INTERNAL_API_SECRET=

# openssl rand -base64 32   (NÃO troque depois: os tokens do Google são criptografados com ela)
ENCRYPTION_KEY=
