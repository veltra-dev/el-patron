{
  "name": "elpatron",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @elpatron/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "evolution:setup": "pnpm --filter @elpatron/api evolution:setup",
    "db:migrate": "tsx --env-file=apps/api/.env scripts/migrate.ts"
  },
  "devDependencies": {
    "postgres": "^4.1.0",
    "tsx": "^4.23.15"
  }
}
